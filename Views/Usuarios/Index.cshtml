@model List<(ApplicationUser Usuario, string Rol)>
@{
    ViewData["Title"] = "Usuarios";
}
<div class="d-flex justify-content-between align-items-center mb-3">
    <h2>Gestión de usuarios</h2>
    <a asp-action="Create" class="btn btn-primary">+ Nuevo usuario</a>
</div>

<table class="table table-striped">
    <thead><tr><th>Nombre</th><th>Correo</th><th>Rol</th><th></th></tr></thead>
    <tbody>
    @foreach (var item in Model)
    {
        <tr>
            <td>@item.Usuario.NombreCompleto</td>
            <td>@item.Usuario.Email</td>
            <td><span class="badge bg-info text-dark">@item.Rol</span></td>
            <td>
                <a asp-action="Edit" asp-route-id="@item.Usuario.Id" class="btn btn-sm btn-outline-primary">Editar</a>
                <a asp-action="Delete" asp-route-id="@item.Usuario.Id" class="btn btn-sm btn-outline-danger">Eliminar</a>
            </td>
        </tr>
    }
    </tbody>
</table>
