@model Libro
@{ ViewData["Title"] = "Detalle del libro"; }
<h2 class="mb-4">Detalle del libro</h2>
<dl class="row card p-4">
    <dt class="col-sm-3">Título</dt><dd class="col-sm-9">@Model.Titulo</dd>
    <dt class="col-sm-3">Autor</dt><dd class="col-sm-9">@Model.Autor</dd>
    <dt class="col-sm-3">ISBN</dt><dd class="col-sm-9">@Model.ISBN</dd>
    <dt class="col-sm-3">Editorial</dt><dd class="col-sm-9">@Model.Editorial</dd>
    <dt class="col-sm-3">Categoría</dt><dd class="col-sm-9">@Model.Categoria</dd>
    <dt class="col-sm-3">Año</dt><dd class="col-sm-9">@Model.AnioPublicacion</dd>
    <dt class="col-sm-3">Disponibles</dt><dd class="col-sm-9">@Model.CantidadDisponible / @Model.CantidadTotal</dd>
</dl>
<a asp-action="Index" class="btn btn-secondary">Volver</a>
