@model Libro
@{ ViewData["Title"] = "Eliminar libro"; }
<h2 class="mb-4 text-danger">¿Eliminar este libro?</h2>
<dl class="row card p-4">
    <dt class="col-sm-3">Título</dt><dd class="col-sm-9">@Model.Titulo</dd>
    <dt class="col-sm-3">Autor</dt><dd class="col-sm-9">@Model.Autor</dd>
    <dt class="col-sm-3">ISBN</dt><dd class="col-sm-9">@Model.ISBN</dd>
</dl>
<form asp-action="Delete" method="post">
    <input type="hidden" asp-for="Id" />
    <button type="submit" class="btn btn-danger">Sí, eliminar</button>
    <a asp-action="Index" class="btn btn-secondary">Cancelar</a>
</form>
