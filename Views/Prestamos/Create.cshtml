@model PrestamoRegistroViewModel
@{ ViewData["Title"] = "Registrar préstamo"; }
<h2 class="mb-4">Registrar préstamo</h2>
<form asp-action="Create" method="post" class="card p-4">
    <div asp-validation-summary="ModelOnly" class="text-danger"></div>
    <div class="mb-3">
        <label class="form-label">Libro</label>
        <select asp-for="LibroId" class="form-select" asp-items="@(new SelectList(Model.LibrosDisponibles, "Id", "Titulo"))">
            <option value="">-- Seleccione un libro --</option>
        </select>
    </div>
    <div class="mb-3">
        <label class="form-label">Usuario</label>
        <select asp-for="UsuarioId" class="form-select" asp-items="@(new SelectList(Model.UsuariosDisponibles, "Id", "NombreCompleto"))">
            <option value="">-- Seleccione un usuario --</option>
        </select>
    </div>
    <div class="mb-3">
        <label asp-for="FechaDevolucionEsperada" class="form-label"></label>
        <input asp-for="FechaDevolucionEsperada" class="form-control" type="date" />
    </div>
    <button type="submit" class="btn btn-primary">Registrar</button>
    <a asp-action="Index" class="btn btn-secondary">Cancelar</a>
</form>
